{
  "name": "Go",
  "image": "ghcr.io/bare-devcontainer/golang:1.27-trixie@sha256:ef804c36a9e4840e3c080da8af3a9d8d6b7a5536b061809a24c206a67a205eb0",
  "features": {
    "ghcr.io/bare-devcontainer/features/claude-code:1.1.0": {}
  },
  "runArgs": [
    "--cap-drop=ALL"
  ],
  "securityOpt": ["no-new-privileges"],
  "remoteUser": "dev",
  "init": true,
  "remoteEnv": {
    "VISUAL": "code --wait",
    "EDITOR": "code --wait",
    "GIT_EDITOR": "code --wait",
    "GOEXPERIMENT": "jsonv2"
  },
  "mounts": [
    {
      "source": "${devcontainerId}-golang-pkg-mod",
      "target": "/home/dev/go/pkg/mod",
      "type": "volume"
    },
    {
      "source": "${devcontainerId}-golang-build-cache",
      "target": "/home/dev/.cache/go-build",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        // renovate: datasource=github-tags depName=anthropics/claude-code
        "anthropic.claude-code@2.1.241",
        // renovate: datasource=github-tags depName=editorconfig/editorconfig-vscode
        "EditorConfig.EditorConfig@0.18.2",
        // renovate: datasource=github-tags depName=golang/vscode-go
        "golang.go@0.56.0"
      ],
      "settings": {
        "json.schemaDownload.trustedDomains": {
          "https://schemastore.azurewebsites.net/": true,
          "https://raw.githubusercontent.com/microsoft/vscode/": true,
          "https://raw.githubusercontent.com/devcontainers/spec/": true,
          "https://www.schemastore.org/": true,
          "https://json.schemastore.org/": true,
          "https://json-schema.org/": true,
          "https://developer.microsoft.com/json-schemas/": true,
          "https://docs.renovatebot.com/": true
        },
        "go.toolsManagement.autoUpdate": false,
        "go.toolsManagement.checkForUpdates": "local",
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "gopls": {
          "ui.semanticTokens": true
        }
      }
    }
  }
}
